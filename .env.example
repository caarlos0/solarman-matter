# Developer credentials of the Solarman app. Ask service@solarmanpv.com for
# them; they are not self-service.
SOLARMAN_APP_ID=
SOLARMAN_APP_SECRET=

# The SOLARMAN Smart or SOLARMAN Business account that owns the plants.
SOLARMAN_EMAIL=
SOLARMAN_PASSWORD=

# Optional. Merchant id of a SOLARMAN Business account. Leave it empty for a
# SOLARMAN Smart account, or the plant list comes back empty.
SOLARMAN_ORG_ID=

# Optional. Overrides the data center. Use https://api.solarmanpv.com for an
# account that lives in China.
SOLARMAN_ENDPOINT=

# Optional. Seconds between Solarman cloud reads. The cloud refreshes about
# every five minutes, and each read spends part of the call allowance.
SOLARMAN_POLL_INTERVAL=300

# Optional. Port of the web page that lists the plants.
SOLARMAN_WEB_PORT=8080

# Optional. File that stores which devices are exposed.
# Defaults to <matter storage>/solarman-matter-devices.json
SOLARMAN_STATE_FILE=

# Optional. Matter commissioning data.
MATTER_PASSCODE=20202021
MATTER_DISCRIMINATOR=3840
MATTER_PORT=5540
