# Addresses of the Solarman data loggers, one per inverter, comma separated.
# Give each logger a fixed address in your router.
SOLARMAN_LOCAL_HOSTS=192.168.1.50

# Optional. The logger's web login, used once to read its serial number.
# These loggers ship with admin/admin.
SOLARMAN_LOCAL_USER=admin
SOLARMAN_LOCAL_PASSWORD=admin

# Optional. Seconds between reads. A read is one packet on your own network,
# so this can be short.
SOLARMAN_POLL_INTERVAL=30

# Optional. Port of the web page that shows the bridge status.
SOLARMAN_WEB_PORT=8080

# Optional. File that remembers the inverter serial behind each address.
# Defaults to <matter storage>/solarman-matter-inverters.json
SOLARMAN_STATE_FILE=

# Optional. Matter commissioning data.
MATTER_PASSCODE=20202021
MATTER_DISCRIMINATOR=3840
MATTER_PORT=5540
